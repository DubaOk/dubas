{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dubas-inquiries",
  "main": "index.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4173,http://localhost:4173", "DEPLOY_REVISION": "local" },
  "d1_databases": [{ "binding": "DB", "database_name": "dubas-inquiries", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "observability": { "enabled": false }
}
