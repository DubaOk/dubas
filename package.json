{
  "name": "dubas-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:production": "node scripts/build-production.mjs",
    "build:ci": "node scripts/build-production.mjs --ci-fixture",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "inquiries:prune": "node scripts/prune-inquiries.mjs",
    "inquiries:retry": "node scripts/retry-inquiry.mjs",
    "telegram:connect": "node scripts/connect-telegram.mjs",
    "cloudflare:connect-ci": "node scripts/connect-cloudflare-ci.mjs",
    "firebase:connect-ci": "node scripts/connect-firebase-ci.mjs",
    "deployment:configure": "node scripts/configure-deployment.mjs",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir .qa/worker",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "15.36.0",
    "typescript": "^5.9.0",
    "wrangler": "4.163.0"
  }
}
