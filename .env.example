# Set the real HTTPS domain before publishing. Leave blank for local preview.
NEXT_PUBLIC_SITE_URL=
# Enable only after contacts, provider details and publication requirements are checked.
SITE_INDEXABLE=false
# Optional URL of the enquiry API when hosting the static files separately.
# Leave blank for the bundled preview server (same origin /api/inquiries).
NEXT_PUBLIC_INQUIRY_ENDPOINT=
# Server-only configuration. Do not use a NEXT_PUBLIC_ prefix for private data.
INQUIRY_STORAGE_DIR=.data
INQUIRY_ALLOWED_ORIGINS=

# Optional subdirectory for static hosting, e.g. /dubas. Leave blank locally.
NEXT_PUBLIC_BASE_PATH=
# Set to true only for a static preview with the enquiry form disabled.
NEXT_PUBLIC_STATIC_PREVIEW=false
